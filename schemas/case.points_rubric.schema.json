{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doximity.com/bedside-bench/schemas/case.points_rubric.schema.json",
  "title": "Points-rubric case",
  "description": "A single evaluation case graded by a physician-authored weighted rubric. Items with positive points are criteria a strong response should satisfy; items with negative points describe failure modes (e.g. endorsing a fabricated drug or trial) that penalize the response if satisfied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "benchmark",
    "grading_method",
    "prompt",
    "rubric_items",
    "split"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "benchmark": { "type": "string", "minLength": 1 },
    "grading_method": { "const": "points_rubric" },
    "prompt": { "type": "string", "minLength": 1 },
    "split": { "type": "string", "enum": ["train", "test"] },
    "rubric_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "text", "points"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "points": { "type": "number" }
        }
      }
    }
  }
}
